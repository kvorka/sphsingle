#!/bin/bash
###########################################################################################
####                              COMPILER SET UP                                      ####
###########################################################################################
fcompile="gfortran-12 -Ofast \
                     -march=native \
                     -mprefer-vector-width=512 \
                     -fno-bounds-check \
                     -flto=auto \
                     -fwhole-program \
                     -fopenmp"

ccompile="gcc-12 -Ofast \
                 -march=native \
                 -mprefer-vector-width=512 \
                 -fno-strict-aliasing \
                 -flto=auto \
                 -funroll-loops \
                 -fomit-frame-pointer \
                 -fwhole-program \
                 -fopenmp"

#fcompile="ifort -fast \
#                -Ofast \
#                -ipo \
#                -ffast-math \
#                -funroll-loops \
#                -xHost \
#                -qopt-zmm-usage=high \
#                -qopenmp \
#                -diag-disable=10448 \
#                -diag-disable=11003 \
#                -diag-disable=11021"
#  
#ccompile="icx -fast \
#              -Ofast \
#              -no-ansi-alias \
#              -ffast-math \
#              -funroll-loops \
#              -xHost \
#              -qopt-zmm-usage=high \
#              -qopenmp"

###########################################################################################
####                            BUILDING OBJ INTERFACES                                ####
###########################################################################################
$fcompile -c src/math/math.f90
$fcompile -c src/fft/fourier_transform.f90
$fcompile -c src/lgp/lege_poly.f90
$fcompile -c src/sph/lateral_grid.f90
$fcompile -c src/sphpack.f90

###########################################################################################
####                         BUILDING FORTRAN IMPLEMENTATIONS                          ####
###########################################################################################
$fcompile -c src/math/arr/*.f90 &
$fcompile -c src/fft/init/*.f90 &
$fcompile -c src/fft/codelets/*.f90 &
$fcompile -c src/fft/cores/*.f90 &
$fcompile -c src/fft/transform/*.f90 &
$fcompile -c src/lgp/init/*.f90 &
$fcompile -c src/lgp/indexing/*.f90 &
$fcompile -c src/lgp/transform/*.f90 &
$fcompile -c src/sph/init/*.f90 &
$fcompile -c src/sph/cores/*.f90 &
wait

###########################################################################################
####                             BUILDING C IMPLEMENTATIONS                            ####
###########################################################################################
$ccompile -c src/lgp/codelets/avx/*.c &
wait

###########################################################################################
####                              LINKING TO MAIN CODE                                 ####
###########################################################################################
$fcompile test.f90 *.o -o sphpack_test

###########################################################################################
####                                      CLEANING                                     ####
###########################################################################################
rm *.o *.mod *.smod
